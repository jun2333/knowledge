# Chroma 向量库（可被 knowledge.config.mjs 覆盖）
CHROMA_HOST=localhost
CHROMA_PORT=8000

# 后端服务端口
PORT=3000

# 远程大模型 / 远程向量库的密钥（默认走本地，无需配置）
# 在 knowledge.config.mjs 里用 apiKeyEnv / tokenEnv 指定「从哪个变量读」，例如：
# OPENAI_API_KEY=sk-xxx
# DEEPSEEK_API_KEY=sk-xxx
# CHROMA_TOKEN=xxx

# 可选：指定配置文件路径（默认从当前目录向上查找 knowledge.config.mjs）
# KNOWLEDGE_CONFIG=./knowledge.config.mjs
