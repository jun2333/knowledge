{
  "name": "front-end-knowledge-summary",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "kb dev",
    "dev:docs": "vitepress dev docs",
    "dev:server": "kb serve",
    "build": "BASE_PATH=${BASE_PATH:-/knowledge/} kb build",
    "preview": "BASE_PATH=/knowledge/ kb preview",
    "rag:index": "kb index",
    "rag:index:full": "kb index --full",
    "rag:eval": "kb eval",
    "rag:gen-eval": "kb eval --full",
    "test:rag": "kb eval",
    "test:rag:full": "kb eval --full",
    "test:rag:baseline": "kb eval:baseline",
    "rag:gen-cases": "kb cases:gen",
    "rag:review-cases": "kb cases:review",
    "chroma:start": "docker run -d -p 8000:8000 --name chroma -v ./data/chroma:/data chromadb/chroma:latest",
    "chroma:stop": "docker stop chroma && docker rm chroma",
    "ollama:ps": "ollama ps",
    "ollama:list": "ollama list",
    "ollama:stop": "ollama stop qwen3:8b && ollama stop bge-m3:latest",
    "ollama:pull-chat": "ollama pull qwen3:8b",
    "ollama:pull-embed": "ollama pull bge-m3:latest",
    "sync": "node scripts/sync-local.mjs",
    "sync:starter": "node scripts/sync-starter.mjs"
  },
  "dependencies": {
    "@kb/core": "link:../kb-base/packages/core",
    "@kb/site": "link:../kb-base/packages/site"
  },
  "devDependencies": {
    "vitepress": "^1.6.4",
    "vue": "^3.5.0"
  }
}
