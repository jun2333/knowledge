{
  "name": "front-end-knowledge-summary",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "dev:docs": "pnpm --filter @knowledge/docs dev",
    "dev:server": "pnpm --filter @knowledge/server dev",
    "build": "pnpm --filter @knowledge/docs build",
    "rag:index": "pnpm --filter @knowledge/server rag:index",
    "chroma:start": "docker run -d -p 8000:8000 --name chroma -v ./server/data/chroma:/chroma/chroma chromadb/chroma:latest",
    "chroma:stop": "docker stop chroma && docker rm chroma"
  }
}
